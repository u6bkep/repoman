# systemd unit for a build worker running as root. Install to
# /etc/systemd/system/. The executor needs mounts, namespaces, and a
# delegated cgroup subtree; everything else is locked down.

[Unit]
Description=repoman build worker
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/repoman worker --config /etc/repoman/worker.toml
Restart=always
RestartSec=5
Environment=RUST_LOG=info

# cgroup v2 delegation for per-job limits and peak accounting.
Delegate=yes
DelegateSubgroup=supervisor

# Filesystem: read-only system, writable scratch and config only.
# StateDirectory creates /var/lib/repoman-worker and makes it writable.
ProtectSystem=strict
StateDirectory=repoman-worker
ReadOnlyPaths=/etc/repoman
PrivateTmp=yes
ProtectHome=read-only
# Needed for mount(2), unshare(2), chroot(2), setuid into build roots,
# pacman -r, and cgroup management.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_MKNOD CAP_NET_ADMIN CAP_SYS_PTRACE CAP_KILL CAP_SETPCAP CAP_SETFCAP
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
